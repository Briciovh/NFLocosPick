rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Fotos de perfil ─────────────────────────────────────────────────────
    // Ruta fija por usuario (profile_photos/{userId}): cada subida sobreescribe
    // la anterior, sin objetos huérfanos que limpiar.
    match /profile_photos/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Fotos de grupo ──────────────────────────────────────────────────────
    // Ruta fija por grupo (group_photos/{groupId}): cada subida sobreescribe
    // la anterior. Solo el creador del grupo (createdBy en Firestore) puede
    // escribir — espejo del permiso de edición ya usado en firestore.rules
    // para los campos photoUrl/iconId del documento del grupo.
    match /group_photos/{groupId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
