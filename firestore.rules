rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfiles de usuario ──────────────────────────────────────────────────
    // Solo el propio usuario puede escribir su perfil.
    // Cualquier usuario autenticado puede leer (para mostrar nombres en grupos).
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;

      // isActive/disabledAt (PR-20) son la excepción: el dueño puede escribir
      // cualquier otro campo de su perfil (incluido lastActive, que se
      // reescribe en cada login), pero NUNCA esos dos — si pudiera, una cuenta
      // deshabilitada por inactividad podría auto-reactivarse escribiendo el
      // doc directamente, sin pasar por un login real. Solo los escribe la
      // Cloud Function "scheduledInactivityCheck" (Admin SDK, bypassa reglas).
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['isActive', 'disabledAt']);

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Reserva de nombres de usuario ────────────────────────────────────────
    // Documento por username (en minúsculas) → { userId }. Garantiza unicidad
    // junto con la transacción de Firestore en UserRepositoryImpl.updateProfile().
    // Nunca se actualiza in-place: cambiar de username crea una reserva nueva
    // y borra la anterior.
    match /usernames/{username} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Grupos ───────────────────────────────────────────────────────────────
    match /groups/{groupId} {

      // Cualquier usuario autenticado puede leer grupos
      // (necesario para buscar por inviteCode al unirse).
      allow read: if request.auth != null;

      // Solo usuarios autenticados pueden crear un grupo,
      // y deben ser el creador y el primer miembro.
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      // Un miembro puede actualizar el grupo (ej: picks, settings futuros).
      // Un usuario no-miembro también puede actualizarlo SOLO para agregarse
      // a sí mismo en memberIds (flujo de unirse con inviteCode).
      // createdBy es inmutable vía update — transferir dueño requeriría un
      // mecanismo dedicado que no existe hoy.
      // photoUrl/iconId/name/inviteCode son la excepción: solo el creador
      // puede tocarlos, sin importar que el requester sea miembro.
      // memberIds: cualquier requester puede sumar como máximo 1 uid (self-join)
      // y nunca puede quitar a nadie de la lista existente; el creador sí puede
      // modificarlo libremente (ej. expulsar a alguien a futuro).
      // Cierra el hallazgo de seguridad de la revisión Codex+Antigravity de
      // sept 2026 (docs/plans/global-default-group.md): antes cualquier
      // miembro podía reescribir createdBy/memberIds/name a su antojo,
      // secuestrando o vaciando un grupo — crítico para el grupo global
      // "NFLocos de Corazón", donde TODO usuario de la app es miembro.
      allow update: if request.auth != null
                    && (
                      request.auth.uid in resource.data.memberIds
                      || request.auth.uid in request.resource.data.memberIds
                    )
                    && request.resource.data.createdBy == resource.data.createdBy
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['photoUrl', 'iconId', 'name', 'inviteCode', 'blockedIds'])
                      || request.auth.uid == resource.data.createdBy
                    )
                    && (
                      request.auth.uid == resource.data.createdBy
                      || (
                        request.resource.data.memberIds.hasAll(resource.data.memberIds)
                        && request.resource.data.memberIds.size() <= resource.data.memberIds.size() + 1
                        && !(request.auth.uid in resource.data.get('blockedIds', []))
                      )
                    );

      // El borrado de grupo va EXCLUSIVAMENTE por la Cloud Function `deleteGroup`
      // (Admin SDK — functions/src/groupDeletion.ts): además del doc, esa función
      // limpia las subcolecciones (weeks/**, board/**) y standings/{groupId}/**,
      // que el cliente no puede borrar (allow write: if false más abajo / en
      // standings). Un delete directo desde el cliente dejaría todo eso huérfano,
      // así que se bloquea aquí. La función valida que el requester sea createdBy y
      // rechaza el grupo global "NFLocos de Corazón".
      allow delete: if false;

      // ── Subcolecciones de semanas y picks (PR-5 y PR-6) ──────────────────
      match /weeks/{weekId} {
        allow read:  if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Cachea el calendario de ESPN (ScheduleRepositoryImpl.cacheGamesToFirestore
        // hace un set() sin merge de { games: [...] }) — write legítimo de cualquier
        // miembro, no se puede bloquear con "if false" sin romper el cacheo de
        // horarios para todos los grupos. Sí se restringe la forma del documento a
        // solo la clave "games" para que no se pueda inyectar contenido arbitrario
        // ni reemplazar el doc entero con basura (hallazgo Antigravity, sept 2026,
        // ver docs/plans/global-default-group.md — crítico para el grupo global,
        // donde TODO usuario de la app es "miembro").
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                     && request.resource.data.keys().hasOnly(['games']);

        // El cliente solo escribe pickedTeam. isCorrect/scoredAt/winnerTeamAbbr
        // NUNCA viven acá — si vivieran acá, un usuario podría escribir
        // isCorrect:true en su propio pick con una llamada directa al SDK,
        // sin pasar por la app. Ver /results más abajo.
        match /picks/{userId} {
          allow read:  if request.auth != null
                       && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow write: if request.auth != null
                       && request.auth.uid == userId
                       && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        // Resultado del scoring (isCorrect/scoredAt/winnerTeamAbbr por gameId).
        // Solo la Cloud Function "scoreGroupWeek"/"scheduledScoring" escribe acá
        // (Admin SDK bypassa las reglas) — es la única fuente de verdad de
        // aciertos, separada del doc de picks para que el cliente no pueda
        // falsificarla.
        match /results/{userId} {
          allow read:  if request.auth != null
                       && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow write: if false;
        }
      }

      // ── Tablero de mensajes / anuncios (feature de Group Board) ───────────
      // Espejo del modelo de permisos de BoardViewModel: cualquier miembro
      // puede leer y enviar; editar contenido el autor o el admin; eliminar el
      // autor o el admin del grupo (createdBy). El campo isAnnouncement (PR-18)
      // es la excepción: solo el admin puede tocarlo, sin importar que el
      // requester sea el autor del mensaje — mismo patrón que photoUrl/iconId
      // en groups/{groupId} más arriba.
      match /board/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                      && request.resource.data.senderId == request.auth.uid;

        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                      && (
                        request.auth.uid == resource.data.senderId
                        || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
                      )
                      && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAnnouncement'])
                        || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
                      );

        allow delete: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                      && (
                        request.auth.uid == resource.data.senderId
                        || request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
                      );
      }
    }

    // ── Standings (PR-7) ─────────────────────────────────────────────────────
    match /standings/{groupId}/members/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      // Escritura normal solo desde Cloud Functions (PR-6).
      // Carve-out estrechísimo para des-ocultar el standing cuando un usuario vuelve a
      // unirse al grupo (joinGroup): solo el propio usuario, solo si es miembro, y solo
      // puede tocar/borrar 'hidden' y 'hiddenAt' (nunca totalPoints ni weeklyBreakdown).
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenAt']);
      allow create, delete: if false;
    }
  }
}
