{
  "name": "functions",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integration": "firebase emulators:exec --config ../firebase.emulator.json --project demo-nflocospicks --only firestore \"jest --selectProjects integration\"",
    "pretest:rules": "node scripts/ensure-emulators.mjs",
    "test:rules": "firebase emulators:exec --config ../firebase.emulator.json --project demo-nflocospicks --only firestore,storage \"jest --selectProjects rules\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:global-group": "npm run build && node lib/scripts/seedGlobalGroup.js",
    "backfill:global-group-membership": "npm run build && node lib/scripts/backfillGlobalGroupMembership.js",
    "backfill:last-active": "npm run build && node lib/scripts/backfillLastActive.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^29.5.14",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.29.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  }
}
